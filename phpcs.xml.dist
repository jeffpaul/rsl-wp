<?xml version="1.0"?>
<ruleset name="RSL Licensing">
	<description>WordPress Coding Standards for the RSL Licensing plugin.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Warnings are still reported but do not fail the check. -->
	<config name="ignore_warnings_on_exit" value="1"/>

	<config name="minimum_wp_version" value="5.0"/>
	<config name="testVersion" value="8.0-"/>

	<rule ref="WordPress">
		<!--
		Documentation and style rules are disabled for now so the check can
		pass on the existing code. Re-enable them in follow-up cleanup PRs.
		-->
		<exclude name="Squiz.Commenting.InlineComment"/>
		<exclude name="Squiz.Commenting.FunctionComment"/>
		<exclude name="Squiz.Commenting.VariableComment"/>
		<exclude name="Squiz.Commenting.FileComment"/>
		<exclude name="Squiz.Commenting.ClassComment"/>
		<exclude name="Squiz.PHP.CommentedOutCode"/>
		<exclude name="Generic.Commenting.DocComment"/>
		<exclude name="WordPress.PHP.YodaConditions"/>
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<!-- The main plugin file defines the rsl_log() helper next to the bootstrap class. -->
	<rule ref="Universal.Files.SeparateFunctionsFromOO">
		<exclude-pattern>/rsl-wp\.php$</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="rsl-wp"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="rsl_"/>
				<element value="RSL_"/>
			</property>
		</properties>
		<!-- Admin templates are included from RSL_Admin methods, so their variables are local. -->
		<exclude-pattern>/admin/templates/*</exclude-pattern>
	</rule>
</ruleset>
